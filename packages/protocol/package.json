{
  "name": "pi-hermes-gateway-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Stateless wire/adapter/delivery protocol types and trust-boundary validators. Provisional local name; not an npm-scope claim.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
